# Backend
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Allow localhost company URLs (needed for batch evaluate against local fixtures)
ALLOW_PRIVATE_URLS=true

# LLM — Groq free tier (https://console.groq.com)
# Alternative: set LLM_PROVIDER=gemini and GEMINI_API_KEY
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Rate limiting / retries
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_MS=2000
CRAWL_DELAY_MS=400
CRAWL_MAX_PAGES=12

# Frontend (Next.js) — copy to frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:4000
